# Base URL of the Laravel backend (origin, WITHOUT a trailing /api suffix).
# This is the single source of truth for API configuration in the frontend
# (see src/config/env.ts). The legacy VITE_API_URL (with /api) is still
# honoured as a fallback and stripped automatically.
VITE_API_BASE_URL=http://localhost:8000

# Local Reverb (WebSocket) configuration
VITE_REVERB_APP_KEY=my-app-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Legacy Pusher configuration (only used when VITE_PUSHER_APP_KEY is set)
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=mt1
