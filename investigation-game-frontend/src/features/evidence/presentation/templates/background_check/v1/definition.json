{
  "id": "background_check",
  "version": 1,
  "name": { "en": "Background Check", "ar": "التحقق من الخلفية" },
  "category": { "en": "Records bureau", "ar": "مكتب السجلات" },
  "types": ["document", "forensic"],
  "characterPrefill": { "name": "subject", "portrait": "portrait" },
  "fields": [
    { "key": "subject", "kind": "text", "required": true, "max": 255, "label": { "en": "Subject", "ar": "الشخص المعني" } },
    { "key": "reference", "kind": "text", "max": 100, "label": { "en": "Report reference", "ar": "مرجع التقرير" } },
    { "key": "birth_date", "kind": "date", "label": { "en": "Date of birth", "ar": "تاريخ الميلاد" } },
    { "key": "address", "kind": "text", "max": 500, "label": { "en": "Address on record", "ar": "العنوان المسجل" } },
    { "key": "check_date", "kind": "date", "label": { "en": "Check date", "ar": "تاريخ التحقق" } },
    { "key": "portrait", "kind": "image", "label": { "en": "Subject photograph", "ar": "صورة الشخص المعني" } },
    { "key": "arrests", "kind": "rows", "max": 100, "label": { "en": "Arrest history", "ar": "سجل التوقيف" }, "fields": [
      { "key": "date", "kind": "date", "label": { "en": "Date", "ar": "التاريخ" } },
      { "key": "description", "kind": "text", "required": true, "max": 255, "label": { "en": "Description", "ar": "الوصف" } },
      { "key": "disposition", "kind": "text", "max": 120, "label": { "en": "Disposition", "ar": "النتيجة" } }
    ] },
    { "key": "fingerprints", "kind": "image", "label": { "en": "Fingerprint strip", "ar": "شريط البصمات" } },
    { "key": "notes", "kind": "textarea", "max": 16000, "label": { "en": "Findings and case notes", "ar": "النتائج وملاحظات القضية" } },
    { "key": "reviewer", "kind": "text", "max": 200, "label": { "en": "Reviewing officer", "ar": "الضابط المراجع" } },
    { "key": "signed_date", "kind": "date", "label": { "en": "Sign-off date", "ar": "تاريخ الاعتماد" } }
  ]
}
